; Engine configuration file.
; Godot 4.7.2 — 한얼: 영웅들 (HANEOL: HEROES)

config_version=5

[application]

config/name="한얼: 영웅들"
config/description="HANEOL: HEROES — P0 전투 프로토타입"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon/project_256.png"
config/quit_on_go_back=false
boot_splash/image="res://assets/ui/splash.png"
boot_splash/stretch_mode=1
boot_splash/bg_color=Color(0.04, 0.035, 0.05, 1)

[autoload]

Live3DSwitch="*res://scripts/art/live3d/live3d_switch.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/health_hitbox_hurtbox/plugin.cfg")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy_body"
2d_physics/layer_3="player_hurt"
2d_physics/layer_4="enemy_hurt"
2d_physics/layer_5="obstacle"

[gui]

theme/custom_font="res://assets/fonts/DeogonPrincess.ttf"

[hh]

; 영웅 그림: true = 3D가 준비된 영웅(data/live3d/<id>.tres)은 실시간 3D, 나머지는 구운 그림. false = 모두 구운 그림 (docs/research/live3d_spike.md)
art/live3d=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
