[gd_resource type="Resource" script_class="TutorialData" format=3]

[ext_resource type="Script" path="res://scripts/data/tutorial_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/tutorial_step.gd" id="2_step"]
[ext_resource type="Resource" path="res://data/tutorial/practice_enemy.tres" id="3_practice"]
[ext_resource type="Resource" path="res://data/tutorial/practice_dummy.tres" id="4_dummy"]

[sub_resource type="Resource" id="move"]
script = ExtResource("2_step")
caption = "걷기"
hint = "화면에 손가락을 대고 끌면
그쪽으로 걸어갑니다"
event = &"move"
amount = 320.0

[sub_resource type="Resource" id="combo"]
script = ExtResource("2_step")
caption = "연타"
hint = "제자리에서 톡톡톡 치면 세 번 이어 칩니다
셋째 타는 적을 넘어뜨립니다"
hero_hints = {
"gwanggaeto": "제자리에서 톡톡톡 치면 창으로 세 번 찌릅니다
셋째 타는 적을 넘어뜨립니다",
"sejong": "제자리에서 톡톡톡 치면 글자를 연달아 던집니다
셋째 글자는 크고 세게 날아갑니다",
"shin_saimdang": "제자리에서 톡톡톡 치면 붓을 털어 먹을 날립니다
셋째는 둘레에 먹을 크게 뿌립니다",
"yi_sun_sin": "제자리에서 톡톡톡 치면 칼로 세 번 벱니다
셋째 타는 적을 넘어뜨립니다"
}
event = &"combo"
practice_enemy = ExtResource("4_dummy")
practice_distance = 130.0

[sub_resource type="Resource" id="finisher"]
script = ExtResource("2_step")
caption = "마무리"
hint = "세 번 이은 뒤 한 번 더 톡 치면
첫째 기술로 마무리합니다"
button_hint = "기술 단추를 톡 누르면
첫째 기술이 바로 나갑니다"
event = &"skill_tap"
practice_enemy = ExtResource("4_dummy")
practice_distance = 130.0

[sub_resource type="Resource" id="dash"]
script = ExtResource("2_step")
caption = "내닫기"
hint = "적 쪽으로 화면을 빠르게 튕기면
내닫으며 둘째 기술이 저절로 나갑니다"
hero_hints = {
"sejong": "적 쪽으로 튕기면 닿지 않아도
내달으며 둘째 기술이 저절로 나갑니다",
"yi_sun_sin": "적 쪽으로 튕기면 베며 내닫고 둘째 기술이 저절로,
반대쪽으로 튕기면 뒤로 빠지기"
}
event = &"skill_dash"
practice_enemy = ExtResource("4_dummy")
practice_distance = 130.0

[sub_resource type="Resource" id="charge"]
script = ExtResource("2_step")
caption = "모아 치기"
hint = "화면을 꾹 누르고 있다가 떼면
힘을 모은 셋째 기술이 나갑니다"
button_hint = "기술 단추를 꾹 누르고 있다가 떼면
힘을 모은 셋째 기술이 나갑니다"
event = &"skill_charge"
practice_enemy = ExtResource("4_dummy")
practice_distance = 130.0

[sub_resource type="Resource" id="evade"]
script = ExtResource("2_step")
caption = "회피"
hint = "바닥에 붉은 먹이 번지면 곧 칩니다
번쩍이기 전에 내달려 빠져나가세요"
event = &"evade"
practice_enemy = ExtResource("3_practice")

[sub_resource type="Resource" id="counter"]
script = ExtResource("2_step")
caption = "반격"
hint = "피한 뒤 1초 동안은 맞지 않습니다 (금빛 테두리)
그 안에 톡 치면 강한 반격이 나갑니다"
button_hint = "피한 뒤 1초 동안은 맞지 않습니다 (금빛 테두리)
그 안에 기술 단추를 누르면 반격이 나갑니다"
event = &"skill_counter"
practice_enemy = ExtResource("3_practice")
banner_top = true

[sub_resource type="Resource" id="upgrade"]
script = ExtResource("2_step")
caption = "강화 고르기"
hint = "적을 쓰러뜨려 기운이 차면 강화 패가 나옵니다
셋 중 하나를 눌러 고르세요"
wave_hint = "공력이 차면 경지가 오르고 패 한 장
패는 물결 사이 숨 고르기에서 고른다"
event = &"upgrade"

[resource]
script = ExtResource("1_data")
steps = Array[ExtResource("2_step")]([SubResource("move"), SubResource("combo"), SubResource("finisher"), SubResource("dash"), SubResource("charge"), SubResource("evade"), SubResource("counter"), SubResource("upgrade")])
