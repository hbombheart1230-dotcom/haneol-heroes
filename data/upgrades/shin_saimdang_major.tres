[gd_resource type="Resource" script_class="UpgradePool" format=3]

[ext_resource type="Script" path="res://scripts/run/upgrade_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/run/upgrade_def.gd" id="2_up"]
[ext_resource type="Script" path="res://scripts/run/stat_mod.gd" id="3_mod"]

[sub_resource type="Resource" id="Mod_major_butterflies_0"]
script = ExtResource("3_mod")
target = &"tap"
property = &"extra_butterflies"
op = 0
value = 3.0

[sub_resource type="Resource" id="Up_major_butterflies"]
script = ExtResource("2_up")
id = &"major_butterflies"
title = "풀벌레 · 화접도"
description = "나비 셋이 더 날아온다"
color = Color(0.85, 0.4, 0.55, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_butterflies_0")])

[sub_resource type="Resource" id="Mod_major_cloud_0"]
script = ExtResource("3_mod")
target = &"dash"
property = &"burst_damage"
op = 0
value = 40.0

[sub_resource type="Resource" id="Up_major_cloud"]
script = ExtResource("2_up")
id = &"major_cloud"
title = "발묵 · 먹구름"
description = "번진 먹이 끝날 때 터진다"
color = Color(0.2, 0.2, 0.25, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_cloud_0")])

[sub_resource type="Resource" id="Mod_major_screen_0"]
script = ExtResource("3_mod")
target = &"charge"
property = &"damage_mult"
op = 0
value = 1.0

[sub_resource type="Resource" id="Up_major_screen"]
script = ExtResource("2_up")
id = &"major_screen"
title = "화폭 · 병풍"
description = "가둔 적에게 두 배 피해"
color = Color(0.55, 0.3, 0.62, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_screen_0")])

[sub_resource type="Resource" id="Mod_major_petals_0"]
script = ExtResource("3_mod")
target = &"counter"
property = &"petal_time"
op = 0
value = 3.0

[sub_resource type="Resource" id="Up_major_petals"]
script = ExtResource("2_up")
id = &"major_petals"
title = "매화 · 꽃비"
description = "꽃잎이 3초간 남아 계속 피해"
color = Color(0.85, 0.4, 0.55, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_petals_0")])

[resource]
script = ExtResource("1_pool")
upgrades = Array[ExtResource("2_up")]([SubResource("Up_major_butterflies"), SubResource("Up_major_cloud"), SubResource("Up_major_screen"), SubResource("Up_major_petals")])
