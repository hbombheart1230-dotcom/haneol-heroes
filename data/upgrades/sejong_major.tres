[gd_resource type="Resource" script_class="UpgradePool" format=3]

[ext_resource type="Script" path="res://scripts/run/upgrade_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/run/upgrade_def.gd" id="2_up"]
[ext_resource type="Script" path="res://scripts/run/stat_mod.gd" id="3_mod"]

[sub_resource type="Resource" id="Mod_major_double_0"]
script = ExtResource("3_mod")
target = &"tap"
property = &"outer_radius"
op = 0
value = 190.0

[sub_resource type="Resource" id="Up_major_double"]
script = ExtResource("2_up")
id = &"major_double"
title = "정음진 · 두 겹 고리"
description = "바깥에 글자 고리가 하나 더\n반대로 돈다"
color = Color(0.86, 0.68, 0.32, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_double_0")])

[sub_resource type="Resource" id="Mod_major_shower_0"]
script = ExtResource("3_mod")
target = &"dash"
property = &"extra_stars"
op = 0
value = 4.0

[sub_resource type="Resource" id="Up_major_shower"]
script = ExtResource("2_up")
id = &"major_shower"
title = "유성 · 유성우"
description = "주변에 작은 별 넷이 더 떨어진다"
color = Color(0.3, 0.45, 0.8, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_shower_0")])

[sub_resource type="Resource" id="Mod_major_big_dipper_0"]
script = ExtResource("3_mod")
target = &"charge"
property = &"star_burst_radius"
op = 0
value = 70.0

[sub_resource type="Resource" id="Up_major_big_dipper"]
script = ExtResource("2_up")
id = &"major_big_dipper"
title = "성좌진 · 북두칠성"
description = "별마다 터진다"
color = Color(0.86, 0.68, 0.32, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_big_dipper_0")])

[sub_resource type="Resource" id="Mod_major_stopped_0"]
script = ExtResource("3_mod")
target = &"counter"
property = &"freeze_time"
op = 0
value = 0.8

[sub_resource type="Resource" id="Up_major_stopped"]
script = ExtResource("2_up")
id = &"major_stopped"
title = "해시계 · 멈춘 시간"
description = "느려진 적이 잠시 완전히 멈춘다"
color = Color(0.72, 0.15, 0.12, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_stopped_0")])

[resource]
script = ExtResource("1_pool")
upgrades = Array[ExtResource("2_up")]([SubResource("Up_major_double"), SubResource("Up_major_shower"), SubResource("Up_major_big_dipper"), SubResource("Up_major_stopped")])
