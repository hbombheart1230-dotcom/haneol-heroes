[gd_resource type="Resource" script_class="UpgradePool" format=3]

[ext_resource type="Script" path="res://scripts/run/upgrade_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/run/upgrade_def.gd" id="2_up"]
[ext_resource type="Script" path="res://scripts/run/stat_mod.gd" id="3_mod"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/upgrades/gwanggaeto/major_aftershock.png" id="icon_major_aftershock"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/upgrades/gwanggaeto/major_field.png" id="icon_major_field"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/upgrades/gwanggaeto/major_chain.png" id="icon_major_chain"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/upgrades/gwanggaeto/major_reign.png" id="icon_major_reign"]

[sub_resource type="Resource" id="Mod_major_aftershock_0"]
script = ExtResource("3_mod")
target = &"tap"
property = &"aftershock_delay"
op = 0
value = 0.5

[sub_resource type="Resource" id="Up_major_aftershock"]
script = ExtResource("2_up")
vfx_level_gain = 3
id = &"major_aftershock"
title = "뇌진격 · 여진"
description = "0.5초 뒤 같은 자리에
두 번째 충격파"
icon = ExtResource("icon_major_aftershock")
color = Color(0.85, 0.7, 0.2, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_aftershock_0")])

[sub_resource type="Resource" id="Mod_major_field_0"]
script = ExtResource("3_mod")
target = &"dash"
property = &"field_time"
op = 0
value = 2.5

[sub_resource type="Resource" id="Up_major_field"]
script = ExtResource("2_up")
vfx_level_gain = 3
id = &"major_field"
title = "벽력돌파 · 감전 지대"
description = "내리친 길에 2.5초
감전 지대"
icon = ExtResource("icon_major_field")
color = Color(0.55, 0.45, 0.9, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_field_0")])

[sub_resource type="Resource" id="Mod_major_chain_0"]
script = ExtResource("3_mod")
target = &"charge"
property = &"chain_count"
op = 0
value = 2.0

[sub_resource type="Resource" id="Up_major_chain"]
script = ExtResource("2_up")
vfx_level_gain = 3
id = &"major_chain"
title = "낙뢰 · 연쇄"
description = "벼락마다 근처 적
두 명에게 튄다"
icon = ExtResource("icon_major_chain")
color = Color(0.55, 0.45, 0.9, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_chain_0")])

[sub_resource type="Resource" id="Mod_major_reign_0"]
script = ExtResource("3_mod")
target = &"counter"
property = &"field_time"
op = 0
value = 3.0

[sub_resource type="Resource" id="Up_major_reign"]
script = ExtResource("2_up")
vfx_level_gain = 3
id = &"major_reign"
title = "정복자의 일격 · 천둥 군림"
description = "내리찍은 자리에 3초
천둥 지대"
icon = ExtResource("icon_major_reign")
color = Color(0.8, 0.3, 0.2, 1)
max_stacks = 1
weight = 1.0
mods = Array[ExtResource("3_mod")]([SubResource("Mod_major_reign_0")])

[resource]
script = ExtResource("1_pool")
upgrades = Array[ExtResource("2_up")]([SubResource("Up_major_aftershock"), SubResource("Up_major_field"), SubResource("Up_major_chain"), SubResource("Up_major_reign")])
